.env
.env.*
*.pem
*.key
*_rsa
*_token
.credentials.yml

# Logs and generated artifacts
*.log
*.tmp
coverage/
.nyc_output/

# Local scratch: probe dumps go to /tmp by design (see tools/view.js)
/dump/
/scratch/
*.dump.bin
_site/
